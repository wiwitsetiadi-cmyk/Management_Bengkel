// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS (Tipe Data Khusus)
// ==========================================
enum OrderStatus {
  QUEUE
  WORKING
  APPROVAL
  READY
  PAID
}

enum ItemType {
  JASA
  SPAREPART
}

enum PaymentMethod {
  TUNAI
  QRIS
  SPLIT
}

// ==========================================
// 2. TABEL MEKANIK
// ==========================================
model Mechanic {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  initials  String
  color     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  transactions Transaction[]
}

// ==========================================
// 3. TABEL SPAREPART
// ==========================================
model Sparepart {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String
  stock     Int
  minStock  Int
  price     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

// ==========================================
// 4. TABEL ORDER (PESANAN)
// ==========================================
model Order {
  id            String      @id @default(cuid())
  trackingToken String      @unique
  vehicle       String
  plate         String?
  customerName  String?
  customerPhone String?
  issue         String
  status        OrderStatus @default(QUEUE)
  color         String

  mechanicId    String?
  mechanic      Mechanic?   @relation(fields: [mechanicId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  paidAt        DateTime?

  items         OrderItem[]
  transactions  Transaction[]
}

// ==========================================
// 5. TABEL ORDER ITEM (Rincian Barang/Jasa)
// ==========================================
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type        ItemType
  name        String
  price       Int
  qty         Int

  sparepartId String?
  sparepart   Sparepart? @relation(fields: [sparepartId], references: [id])

  isAdditional Boolean   @default(false) // Penanda biaya tambahan (extra)
  approvedAt   DateTime?                 // ✅ MVP-1 1.1: null = menunggu persetujuan; terisi = sudah disetujui
}

// ==========================================
// 6. TABEL TRANSAKSI (Pembayaran)
// ==========================================
model Transaction {
  id          String        @id @default(cuid())
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  date        DateTime      @default(now())
  type        String
  method      PaymentMethod @default(TUNAI)
  total       Int
  serviceAmount Int
  partsAmount Int
  commission  Int
  paidAmount  Int           @default(0) // ✅ MVP-1 1.3
  changeAmount Int          @default(0) // ✅ MVP-1 1.3

  mechanicId  String?
  mechanic    Mechanic?     @relation(fields: [mechanicId], references: [id])

  items       TransactionItem[] // ✅ MVP-1 1.3
}

// ==========================================
// 6b. TABEL TRANSACTION ITEM (snapshot saat checkout)
// ==========================================
model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  type        ItemType
  name        String
  price       Int
  qty         Int
  sparepartId String?     // ✅ MVP-1 1.3: snapshot, tanpa relasi ke Sparepart
}

// ==========================================
// 7. TABEL PENGATURAN KOMISI
// ==========================================
model CommissionSetting {
  id             String   @id @default("global")
  servicePercent Int      @default(10)
  partsPercent   Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model CommissionOverride {
  id             String   @id @default(cuid())
  mechanicId     String   @unique
  servicePercent Int?
  partsPercent   Int?
  updatedAt      DateTime @updatedAt
}

// ==========================================
// 8. TABEL SERVICE (Katalog Jasa)
// ==========================================
model Service {
  id        String   @id @default(cuid())
  name      String
  price     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}